# Copy to .env and fill in. `.env` is git-ignored. the-llm-dispatcher only ever checks whether
# a key is present; it never prints or logs values. The CLI wrappers strip every key loaded
# from this file before launching Claude Code or Codex, so those keep using their own logins.

# --- the decision model (required for routing; without it the dispatcher falls back to a safe frontier choice)
# Create at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# --- providers for the API proxy (set at least one; the CLI wrappers need none of these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=                      # one key exposes every openrouter/* model in models.json
# OPENAI_BASE_URL=https://api.openai.com/v1     # point the built-in "openai" provider elsewhere
# Local models (Ollama, LM Studio, vLLM): declare the endpoint under "providers" in models.json.

# --- API proxy settings (all optional)
# DISPATCHER_PORT=8787
# DISPATCHER_API_KEY=                    # if set, clients must send Authorization: Bearer <this>
# DISPATCHER_BASELINE=anthropic/claude-opus-5   # "what you'd have used anyway", for savings math
# DISPATCHER_FALLBACK=anthropic/claude-sonnet-5 # model to use when Jev is unreachable
# DISPATCHER_ROUTE_ALL=1                 # route even when the client names a concrete model
# DISPATCHER_LEDGER_PATH=dispatcher-ledger.jsonl
# DISPATCHER_CATALOG=./models.json
# DISPATCHER_JEV_TIMEOUT_MS=5000

# --- CLI wrapper settings (all optional)
# DISPATCHER_CLAUDE_MODELS=claude-haiku-4-5,claude-sonnet-5,claude-opus-5   # subset Claude Code may use
# DISPATCHER_CODEX_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gpt-6-astra
# DISPATCHER_CODEX_BASELINE=gpt-6-astra
# DISPATCHER_NO_STATUSLINE=1             # do not inject the Claude Code status line
