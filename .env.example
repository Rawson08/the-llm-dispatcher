# Copy to .env and fill in. `.env` is git-ignored. frugal only ever checks whether a
# key is present; it never prints or logs values.

# --- the decision model (required for routing; without it frugal falls back to a safe frontier choice)
# Create at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# --- providers you want frugal to route across (set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # point at any OpenAI-compatible server

# --- proxy settings (all optional)
# FRUGAL_PORT=8787
# FRUGAL_API_KEY=                 # if set, clients must send Authorization: Bearer <this>
# FRUGAL_BASELINE=anthropic/claude-opus-5   # "what you'd have used anyway", for savings math
# FRUGAL_FALLBACK=anthropic/claude-sonnet-5 # model to use when Jev is unreachable
# FRUGAL_ROUTE_ALL=1              # route even when the client names a concrete model
# FRUGAL_LEDGER_PATH=frugal-ledger.jsonl
# FRUGAL_CATALOG=./models.json
# FRUGAL_JEV_TIMEOUT_MS=5000
