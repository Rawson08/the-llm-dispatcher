# Copy to .env and fill in. `.env` is git-ignored. the-llm-dispatcher only ever checks whether a
# key is present; it never prints or logs values.

# --- the decision model (required for routing; without it the-llm-dispatcher falls back to a safe frontier choice)
# Create at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# --- providers you want the-llm-dispatcher to route across (set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # point at any OpenAI-compatible server

# --- proxy settings (all optional)
# DISPATCHER_PORT=8787
# DISPATCHER_API_KEY=                 # if set, clients must send Authorization: Bearer <this>
# DISPATCHER_BASELINE=anthropic/claude-opus-5   # "what you'd have used anyway", for savings math
# DISPATCHER_FALLBACK=anthropic/claude-sonnet-5 # model to use when Jev is unreachable
# DISPATCHER_ROUTE_ALL=1              # route even when the client names a concrete model
# DISPATCHER_LEDGER_PATH=dispatcher-ledger.jsonl
# DISPATCHER_CATALOG=./models.json
# DISPATCHER_JEV_TIMEOUT_MS=5000
